---
import '@fontsource/ibm-plex-sans/latin-400.css';
import '@fontsource/ibm-plex-sans/latin-500.css';
import '@fontsource/ibm-plex-sans/latin-600.css';
import '@fontsource/ibm-plex-sans/latin-400-italic.css';
import '@fontsource/ibm-plex-serif/latin-400.css';
import '@fontsource/ibm-plex-mono/latin-400.css';
import '@fontsource/ibm-plex-mono/latin-500.css';
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { profile } from '../data/profile';
interface Props { title?: string; description?: string; schema?: Record<string, unknown>[]; noindex?: boolean; image?: string; bodyClass?: string }
const {
  title = `${profile.name} — embedded systems and software`,
  description = `${profile.name}: CSE student at KUET who designs data-acquisition hardware, writes firmware and builds full-stack web applications. ${profile.availability}.`,
  schema = [], noindex = false, image = '/og.png', bodyClass,
} = Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site);
const og = new URL(image, Astro.site);
const person = {
  '@context': 'https://schema.org', '@type': 'Person', '@id': new URL('/#person', Astro.site).href,
  name: profile.fullName, alternateName: profile.name, url: Astro.site?.href, email: `mailto:${profile.email}`,
  jobTitle: 'Embedded systems and software engineer (student)',
  address: { '@type': 'PostalAddress', addressLocality: 'Khulna', addressCountry: 'BD' },
  alumniOf: { '@type': 'CollegeOrUniversity', name: profile.university },
  sameAs: [profile.github, profile.linkedin],
  knowsAbout: ['Embedded systems', 'PCB design', 'ESP32 firmware', 'Data acquisition', 'Full-stack web development', 'Bangla language technology', 'Compilers'],
};
const graph = [person, ...schema];
---
<!doctype html>
<html lang="en" data-motion="on">
  <head>
    <meta charset="utf-8"/>
    <meta name="viewport" content="width=device-width, initial-scale=1"/>
    <title>{title}</title>
    <meta name="description" content={description}/>
    <meta name="author" content={profile.fullName}/>
    <meta name="robots" content={noindex ? 'noindex, follow' : 'index, follow'}/>
    <meta name="theme-color" content="#f6f4ef" media="(prefers-color-scheme: light)"/>
    <meta name="theme-color" content="#0f1113" media="(prefers-color-scheme: dark)"/>
    <link rel="canonical" href={canonical}/>
    <link rel="icon" href="/favicon.svg" type="image/svg+xml"/>
    <link rel="sitemap" href="/sitemap-index.xml"/>
    <meta property="og:type" content="website"/>
    <meta property="og:site_name" content={profile.name}/>
    <meta property="og:title" content={title}/>
    <meta property="og:description" content={description}/>
    <meta property="og:url" content={canonical}/>
    <meta property="og:image" content={og}/>
    <meta property="og:image:width" content="1200"/>
    <meta property="og:image:height" content="630"/>
    <meta name="twitter:card" content="summary_large_image"/>
    <script type="application/ld+json" set:html={JSON.stringify(graph.length === 1 ? graph[0] : { '@context': 'https://schema.org', '@graph': graph.map(({ ['@context']: _, ...rest }) => rest) }).replace(/</g, '\\u003c')}/>
    <script is:inline>
      document.documentElement.classList.add('js');
      try {
        var t = localStorage.getItem('mr-theme'); if (t === 'light' || t === 'dark') document.documentElement.dataset.theme = t;
        var m = localStorage.getItem('mr-motion');
        if (m === 'off' || matchMedia('(prefers-reduced-motion: reduce)').matches) document.documentElement.dataset.motion = 'off';
      } catch (e) {}
    </script>
  </head>
  <body class={bodyClass}>
    <Header/>
    <slot/>
    <Footer/>
    <div class="toast" role="status" aria-live="polite" data-toast></div>
    <script>import '../scripts/main';</script>
  </body>
</html>
