---
import '../styles/global.css';
import '../styles/studies.css';
import '../styles/motion.css';
import '../styles/paper.css';
import '../styles/living-motion.css';
import '../styles/notebooks.css';
import '../styles/ink.css';
import '../styles/studio.css';
import '../styles/structure.css';
import '@fontsource-variable/manrope';
import '@fontsource/instrument-serif/latin-400.css';
import '@fontsource/instrument-serif/latin-400-italic.css';
import '@fontsource/ibm-plex-mono/latin-400.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { profile } from '../data/profile';
interface Props { title?: string; description?: string; schema?: Record<string, unknown>[]; noindex?: boolean; image?: string; bodyClass?: string }
const {
  title = `${profile.name} — embedded systems and software`,
  description = `${profile.name}: CSE student at KUET who designs data-acquisition hardware, writes firmware and builds full-stack web applications. ${profile.availability}.`,
  schema = [], noindex = false, image = '/og.png', bodyClass,
} = Astro.props;
const is404 = /^\/404\/?$/.test(Astro.url.pathname);
const canonical = new URL(Astro.url.pathname, Astro.site);
const og = new URL(image, Astro.site);
const person = {
  '@context': 'https://schema.org', '@type': 'Person', '@id': new URL('/#person', Astro.site).href,
  name: profile.fullName, alternateName: profile.name, url: Astro.site?.href, email: `mailto:${profile.email}`,
  jobTitle: 'Embedded systems and software engineer (student)',
  address: { '@type': 'PostalAddress', addressLocality: 'Khulna', addressCountry: 'BD' },
  alumniOf: { '@type': 'CollegeOrUniversity', name: profile.university },
  sameAs: [profile.github, profile.linkedin],
  knowsAbout: ['Embedded systems', 'PCB design', 'ESP32 firmware', 'Data acquisition', 'Full-stack web development', 'Local language models', 'Bangla language technology', 'Compilers'],
};
const graph = [person, ...schema];
---
<!doctype html>
<html lang="en" id="top" data-motion="off">
  <head>
    <meta charset="utf-8"/>
    <meta name="viewport" content="width=device-width, initial-scale=1"/>
    <meta name="theme-color" content="#f4f0e7"/>
    <title>{title}</title>
    <meta name="description" content={description}/>
    <meta name="author" content={profile.fullName}/>
    <meta name="robots" content={noindex ? 'noindex, follow' : 'index, follow'}/>
    {!is404 && <link rel="canonical" href={canonical}/>}
    <link rel="icon" href="/favicon.svg" type="image/svg+xml"/>
    <link rel="sitemap" href="/sitemap-index.xml"/>
    <meta property="og:type" content="website"/>
    <meta property="og:site_name" content={profile.name}/>
    <meta property="og:title" content={title}/>
    <meta property="og:description" content={description}/>
    {!is404 && <meta property="og:url" content={canonical}/>}
    <meta property="og:image" content={og}/>
    <meta property="og:image:width" content="1200"/>
    <meta property="og:image:height" content="630"/>
    <meta name="twitter:card" content="summary_large_image"/>
    <script type="application/ld+json" set:html={JSON.stringify(graph.length === 1 ? graph[0] : { '@context': 'https://schema.org', '@graph': graph.map(({ ['@context']: _, ...rest }) => rest) }).replace(/</g, '\\u003c')}/>
    <script is:inline>
      try {
        const saved = localStorage.getItem('mr-motion');
        const reduced = matchMedia('(prefers-reduced-motion: reduce)').matches;
        document.documentElement.dataset.motion = saved === 'off' || reduced ? 'off' : 'on';
      } catch { document.documentElement.dataset.motion = 'off'; }
    </script>
  </head>
  <body class={bodyClass}>
    <Header/>
    <slot/>
    <Footer/>
    <div class="toast" role="status" aria-live="polite" data-toast></div>
    <script>import '../scripts/main';</script>
  </body>
</html>
