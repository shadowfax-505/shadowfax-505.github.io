---
import type { NotebookPage } from '../data/notebooks';
interface Props { page: NotebookPage; number: number; accent: 'red'|'cobalt'; bookId: string; detail?: boolean }
const { page, number, accent, bookId, detail=false } = Astro.props;
const palettes:Record<string,[string,string,string]> = {
  'work-civiclens':['#242b27','#f4f0e7','#f16a50'],
  'work-researchhub':['#dce3da','#24392d','#b83a26'],
  'work-zenflow':['#e8a957','#24251f','#823622'],
  'work-afo-recorder':['#24499b','#f4f0e7','#e5ba6a'],
  'work-gas-safety':['#e3e3d3','#2349a0','#b83a26'],
  'work-drone':['#171f20','#f4f0e7','#99baff'],
  'background':['#f4f0e7','#24251f','#b83a26'],
};
const [stock,ink,color]=palettes[bookId]||['#f4f0e7','#24251f',accent==='cobalt'?'#2349a0':'#b83a26'];
const titles:Record<string,[string,string]> = {
  'evidence-workflow':['Follow the','evidence.'], 'governed-access':['Trust has','boundaries.'],
  'release-record':['A system.','A record.'], 'library-workflow':['Keep the','good ideas.'],
  'oracle-architecture':['Connected','by design.'], 'verified-boundary':['Test the','whole flow.'],
  'desktop-focus':['Make room','for focus.'], 'android-context':['A rhythm','of its own.'],
  'two-platforms':['Two ways','to focus.'], 'shared-clock':['One clock','for all.'],
  'recording-integrity':['Simulated','first.'], 'validation-boundary':['Next stop:','the bench.'],
  'automatic-response':['Sense.','Respond.'], 'web-signal':['A signal','travels.'],
  'documented-rebuild':['Build. Test.','Keep notes.'], 'component-study':['A closer','look.'],
  'remembered-build':['Flown','in public.'], 'future-flight-log':['Next time,','keep a log.'],
  'historical-question':['Old writing.','New questions.'], 'corpus-design':['Start with','the source.'],
  'evaluation-plan':['Measure','what matters.'], 'uncertain-demand':['Enough.','Just in time.'],
  'policy-comparison':['One lab.','Many policies.'], 'service-cost':['Cost meets','consequence.'],
  'language-question':['Source.','Structure.'], 'arithmetic-specimen':['A thought,','parsed.'],
  'pipeline-next':['Make the','rules visible.'], 'systems-map':['Many systems.','One curiosity.'],
  'questions-map':['The questions','between.'], 'earned-milestones':['Physics.','The first spark.'],
  'education':['Still asking','“what if?”'], 'community':['Better','together.'],
  'nagri-pilot':['Read the','unread.'], 'inventory-lab':['Decisions,','under demand.'],
  'local-assistant':['Checked','every time.'], 'measured':['Measured,','not assumed.'],
  'dialect-question':['Does it','survive?'], 'dialect-method':['Matched','pairs.'],
  'lookalike-question':['Same on','screen.'], 'lookalike-method':['Render.','Compile.'],
  'decoder-question':['Let the','compiler steer.'], 'decoder-method':['One rule','book.'],
  'censored-demand':['Sales stop','at the shelf.'], 'censoring-method':['Randomise.','Log it.'],
};
const heading=titles[page.id]||[page.title.split(' ').slice(0,2).join(' '),page.title.split(' ').slice(2).join(' ')];
const portrait=!detail&&(bookId==='work-zenflow'||bookId==='work-researchhub');
const tall=portrait&&bookId==='work-zenflow',height=portrait?(tall?990:804):620;
const artTransform=portrait?(page.art==='stack'?'translate(-490 150) scale(1.25)':tall?'translate(-630 115) scale(1.55)':'translate(-680 -165) scale(1.65)'):undefined;
const nodes=page.nodes;
const flow=['workflow','library','recovery','response','corpus'].includes(page.art);
const ledger=['ledger','checklist','archive','milestones','education'].includes(page.art);
const branches=['map','questions','community','access','web'].includes(page.art);
const lines=(text:string,max=21)=>{const words=text.split(' '),rows:string[]=[];for(const word of words){if(!rows.length||rows[rows.length-1].length+word.length+1>max)rows.push(word);else rows[rows.length-1]+=' '+word;}return rows;};
const wave=Array.from({length:130},(_,i)=>`${i?'L':'M'}${66+i*5.9},${(394-Math.sin(i*.14)*32-(i%30)*3.6).toFixed(1)}`).join(' ');
---
<svg class={`notebook-art art-${page.art}`} data-notebook-art data-motion-color={color} style={{background:stock}} viewBox={`0 0 900 ${height}`} fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
  <rect width="900" height={height} fill={stock}/>
  <g stroke={ink} stroke-width=".8" opacity=".18"><path d={`M55 92h790M55 ${height-62}h790`}/><path d={`M845 112v${height-198}`} stroke-dasharray="1 10"/></g>
  <text x="57" y="65" fill={ink} font-family="IBM Plex Mono, monospace" font-size="12" letter-spacing="1.1">{String(number).padStart(2,'0')} / {page.kicker}</text>
  <g class="notebook-poster-title" fill={ink}>
    <text x="56" y={portrait?205:204} font-family="Manrope Variable, sans-serif" font-weight="550" font-size={portrait?94:heading[0].length>14?61:69} letter-spacing="-3">{heading[0]}</text>
    <text x="55" y={portrait?321:292} fill={color} font-family="Instrument Serif, Georgia, serif" font-style="italic" font-size={portrait?123:heading[1].length>13?78:95} letter-spacing="-2">{heading[1]}</text>
  </g>
  {page.image ? <g><path data-nm-trace d="M58 548h782" stroke={color} opacity=".5"/><rect x="55" y="330" width="790" height="200" fill="#fff" opacity=".96"/><image href={page.image} x="75" y="337" width="750" height="187" preserveAspectRatio="xMidYMid meet"/></g> : <>
    {flow && <g transform={artTransform} data-nm="parallax">
      <g stroke={color} stroke-width="2" opacity=".65"><path data-nm-trace d="M440 354h205v116h-205v-116m205 0h165"/><path d="m801 347 10 7-10 7"/></g>
      {nodes.map((label,i)=>{const x=445+(i%2)*205,y=318+Math.floor(i/2)*115;return <g><rect x={x} y={y} width="180" height="96" rx="1" fill={stock} stroke={ink} stroke-width="1.2"/><text x={x+15} y={y+45} fill={color} font-family="Instrument Serif, Georgia, serif" font-size="43">{String(i+1).padStart(2,'0')}</text>{lines(label,21).map((line,j)=><text x={x+16} y={y+70+j*17} fill={ink} font-family="Manrope Variable, sans-serif" font-size="14">{line}</text>)}</g>})}
      <g stroke={color} opacity=".75" stroke-width="1.1"><path data-nm-trace d="M72 370c72-44 122-36 180-2s81 58 123 32"/><path d="m365 398 12 2-8 11"/></g>
      <text x="57" y="488" fill={ink} opacity=".65" font-family="IBM Plex Mono, monospace" font-size="12">{page.art==='corpus'?'SOURCE → TRANSCRIPTION → TEST':'INPUT → DECISION → FOLLOW-THROUGH'}</text>
    </g>}
    {ledger && !portrait && <g>
      <text x="62" y="489" fill={color} opacity=".85" font-family="Instrument Serif, Georgia, serif" font-style="italic" font-size={(page.figure||'next.').length>7?92:138}>{page.figure||'next.'}</text>
      {nodes.map((label,i)=><g><path data-nm="ledger" data-nm-index={i} d={`M485 ${176+i*83}h330`} stroke={ink} opacity=".28"/><text x="485" y={209+i*83} fill={color} font-family="IBM Plex Mono, monospace" font-size="15">{String(i+1).padStart(2,'0')}</text>{lines(label,27).map((line,j)=><text x="527" y={209+i*83+j*22} fill={ink} font-family="Manrope Variable, sans-serif" font-size="18" font-weight="500">{line}</text>)}</g>)}
    </g>}
    {branches && <g>
      <g stroke={color} stroke-width="1.5"><ellipse data-nm="orbit" cx="642" cy="354" rx="150" ry="144" transform="rotate(-24 642 354)" opacity=".4"/><ellipse data-nm="orbit" data-nm-index="1" cx="642" cy="354" rx="150" ry="70" transform="rotate(30 642 354)" opacity=".8"/>{nodes.map((_,i)=>{const a=i/nodes.length*Math.PI*2-.45,x=642+Math.cos(a)*150,y=354+Math.sin(a)*142;return <path data-nm-trace d={`M642 354Q${642+(x-642)*.4} ${y} ${x} ${y}`} opacity=".7"/>})}</g>
      <circle cx="642" cy="354" r="48" fill={color}/><text x="642" y="366" text-anchor="middle" fill={stock} font-family="Instrument Serif, Georgia, serif" font-style="italic" font-size="37">{page.art==='access'?'review':page.art==='community'?'us':'m/r'}</text>
      {nodes.map((_,i)=>{const a=i/nodes.length*Math.PI*2-.45,x=642+Math.cos(a)*150,y=354+Math.sin(a)*142;return <g><circle cx={x} cy={y} r="14" fill={stock} stroke={color} stroke-width="1.5"/><text x={x} y={y+5} text-anchor="middle" fill={ink} font-family="IBM Plex Mono, monospace" font-size="11">{i+1}</text></g>})}
      <g fill={ink} font-family="Manrope Variable, sans-serif" font-size="16">{nodes.map((label,i)=><text x={58+(i%2)*212} y={359+Math.floor(i/2)*58}><tspan fill={color} font-family="IBM Plex Mono, monospace" font-size="12">{String(i+1).padStart(2,'0')} / </tspan>{label}</text>)}</g>
    </g>}
    {page.art==='stack' && <g transform={artTransform}>{nodes.map((label,i)=><g data-nm="layer" data-nm-index={i} transform={`translate(${435+i*18},${170+i*84})`}><path d="M0 0h316l-12 62H-12z" fill={stock} stroke={ink} stroke-width="1.5"/><text x="12" y="36" fill={i===2?color:ink} font-family="Manrope Variable, sans-serif" font-weight="500" font-size="20">{label}</text><path d="m276 20 8 8-8 8" stroke={color}/></g>)}</g>}
    {['desktop','phone','platforms'].includes(page.art) && <g transform={artTransform}>
      <g data-nm="device" transform="translate(430 178)" stroke={ink} stroke-width="1.5"><rect width="335" height="224" rx="7"/><path d="M0 26h335M140 224v35m-54 0h120"/><circle data-nm="focus" cx="167" cy="123" r="70" stroke={color} stroke-dasharray="360 80"/><text x="167" y="138" text-anchor="middle" fill={ink} stroke="none" font-family="Manrope Variable, sans-serif" font-size="43" letter-spacing="-2">25:00</text></g>
      <g data-nm="device" data-nm-index="1" transform="translate(704 278) rotate(7)" stroke={ink} stroke-width="1.5"><rect width="115" height="220" rx="15" fill={stock}/><path d="M37 13h40M33 206h48"/><circle data-nm="focus" cx="58" cy="105" r="36" stroke={color} stroke-dasharray="180 46"/><text x="58" y="113" text-anchor="middle" fill={ink} stroke="none" font-family="Instrument Serif, Georgia, serif" font-style="italic" font-size="26">focus.</text></g>
      {nodes.map((label,i)=><text x="57" y={360+i*40} fill={ink} font-family="IBM Plex Mono, monospace" font-size="15"><tspan fill={color}>{String(i+1).padStart(2,'0')} / </tspan>{label}</text>)}
    </g>}
    {page.art==='drone-parts' && <g>
      <g data-nm="flight" transform="translate(550 355) rotate(-19)" stroke={ink} stroke-width="1.4"><path d="m-95-74 190 148M95-74-95 74" stroke-width="18" opacity=".15"/><path d="m-95-74 190 148M95-74-95 74"/>{[[-95,-74],[95,-74],[-95,74],[95,74]].map(([x,y])=><g><ellipse data-nm="rotor" cx={x} cy={y} rx="75" ry="18" stroke={color}/><circle cx={x} cy={y} r="27"/><circle cx={x} cy={y} r="19" stroke-dasharray="1 3"/><path d={`M${x-39} ${y}h78M${x} ${y-29}v58`} opacity=".4"/></g>)}<rect x="-39" y="-38" width="78" height="76" rx="8"/><path d="M-23-23h46v46h-46zM-16 30v20m32-20v20" stroke={color}/></g>
      {nodes.map((label,i)=><g><path d={`M60 ${362+i*42}h40`} stroke={color}/><text x="113" y={367+i*42} fill={ink} font-family="IBM Plex Mono, monospace" font-size="17">{label}</text></g>)}
      <text x="815" y="520" text-anchor="end" fill={color} font-family="IBM Plex Mono, monospace" font-size="10">ILLUSTRATIVE / ORIGINAL PARTS UNKNOWN</text>
    </g>}
    {page.art==='glyph' && <g>
      <text x="484" y="501" fill={color} font-family="Noto Sans Syloti Nagri, sans-serif" font-size="365">ꠇ</text>
      <g fill={ink} font-family="Noto Sans Syloti Nagri, sans-serif" font-size="58">{nodes.map((label,i)=><text x={60+i*78} y="446">{label}</text>)}</g>
      <path data-nm-trace d="M60 474c80 2 161-4 295-1" stroke={color} stroke-width="1.2"/>
      <text x="60" y="511" fill={ink} font-family="IBM Plex Mono, monospace" font-size="12">A MODERN TYPE SPECIMEN / HISTORICAL QUESTIONS</text>
    </g>}
    {['inventory','policies'].includes(page.art) && <g>
      <g stroke={ink} stroke-width=".8" opacity=".18">{[330,390,450,510].map(y=><path d={`M62 ${y}h766`}/>)}<path d="M62 317v197h766"/></g>
      <path data-nm="wave" d={wave} stroke={color} stroke-width="3"/><path data-nm-trace d="M66 393h756" stroke={ink} stroke-width="1.3" stroke-dasharray="7 9" opacity=".55"/>
      {page.art==='policies'&&<path d="M66 432c90-130 155-111 225-20s143 51 219-63 173-11 312-36" stroke={ink} stroke-width="2"/>}
      {nodes.map((label,i)=><text x={68+i*192} y="544" fill={ink} font-family="IBM Plex Mono, monospace" font-size="11">{label}</text>)}
      <text x="824" y="188" text-anchor="end" fill={color} font-family="Instrument Serif, Georgia, serif" font-style="italic" font-size="120">?</text>
    </g>}
    {page.art==='evaluation' && <g>
      {nodes.map((label,i)=>{const x=500+(i%2)*195,y=205+Math.floor(i/2)*185;return <g><circle cx={x+56} cy={y+44} r="54" stroke={color} stroke-width="1.6"/><circle data-nm="orbit" data-nm-index={i} cx={x+56} cy={y+44} r="46" stroke={ink} stroke-width=".6" stroke-dasharray="1 5" opacity=".45"/><text x={x+56} y={y+65} text-anchor="middle" fill={color} font-family="Instrument Serif, Georgia, serif" font-style="italic" font-size="68">{i+1}</text>{lines(label,18).map((line,j)=><text x={x+56} y={y+116+j*20} text-anchor="middle" fill={ink} font-family="Manrope Variable, sans-serif" font-size="16">{line}</text>)}</g>})}
      <path data-nm-trace d="M63 391c39-28 92-36 143-15s96 9 145-26" stroke={color} stroke-width="2"/>
      <text x="58" y="485" fill={ink} font-family="IBM Plex Mono, monospace" font-size="12">PROPOSED EVALUATION / RESULTS FOLLOW THE WORK</text>
    </g>}
    {['tree','tokens'].includes(page.art) && <g>
      <g stroke={color} stroke-width="2"><path data-nm-trace d="M642 180 532 310M642 180 752 310 682 443M752 310 822 443"/>
        {[[642,180,'+'],[532,310,'2'],[752,310,'×'],[682,443,'3'],[822,443,'4']].map(([x,y,t])=><g><circle cx={x} cy={y} r="40" fill={stock}/><text x={x} y={Number(y)+16} text-anchor="middle" fill={ink} stroke="none" font-family="IBM Plex Mono, monospace" font-size="44">{t}</text></g>)}
      </g>
      <text x="57" y="393" fill={color} font-family="Instrument Serif, Georgia, serif" font-style="italic" font-size="67">2 + 3 × 4</text>
      <path d="M59 420h301m-8-5 8 5-8 5" stroke={color}/>
      <text x="57" y="477" fill={ink} font-family="IBM Plex Mono, monospace" font-size="14">{page.art==='tokens'?'TOKENS → TREE → CONSTANT FOLDING':'SOURCE → STRUCTURE → MEANING'}</text>
    </g>}
    {ledger && portrait && <g>
      <text x="57" y="459" fill={color} font-family="Instrument Serif, Georgia, serif" font-style="italic" font-size="115">{page.figure||'next.'}</text>
      {nodes.map((label,i)=><g><path data-nm="ledger" data-nm-index={i} d={`M${57+(i%2)*405} ${500+Math.floor(i/2)*110}h365`} stroke={ink} opacity=".3"/><text x={57+(i%2)*405} y={530+Math.floor(i/2)*110} fill={color} font-family="IBM Plex Mono, monospace" font-size="14">0{i+1}</text>{lines(label,28).map((line,j)=><text x={57+(i%2)*405} y={557+Math.floor(i/2)*110+j*24} fill={ink} font-family="Manrope Variable, sans-serif" font-size="20">{line}</text>)}</g>)}
    </g>}
    {portrait&&!ledger&&!flow&&page.art!=='stack'&&<g fill={ink} font-family="IBM Plex Mono, monospace" font-size="13">{nodes.map((label,i)=><text x={57+(i%2)*420} y={height-70+Math.floor(i/2)*20}>{String(i+1).padStart(2,'0')} / {label}</text>)}</g>}
  </>}
  <text x="57" y={height-30} fill={ink} opacity=".72" font-family="IBM Plex Mono, monospace" font-size="10" letter-spacing="1">M / R — {bookId.startsWith('work-')?'SELECTED WORK':'FIELD JOURNAL'}</text>
  <text x="843" y={height-30} text-anchor="end" fill={color} font-family="IBM Plex Mono, monospace" font-size="11">0{number} / TURN THE PAGE ↗</text>
</svg>
