<figure class="robot-studio" data-robot-studio data-robot-state="poster">
  <div class="studio-topline eyebrow" aria-hidden="true"><span>FIG. 002 / ROBOTIC PAPER STUDIO</span><span class="studio-coordinate">PRECISION & CURIOSITY</span></div>
  <div class="robot-stage" data-robot-stage role="img" aria-label="An original articulated ceramic and metal robot folds a paper sample.">
    <picture class="robot-poster">
      <source media="(max-width:700px)" srcset="/assets/robotic-studio-720.webp 720w" sizes="90vw" type="image/webp"/>
      <source srcset="/assets/robotic-studio-1440.webp 1440w" sizes="56vw" type="image/webp"/>
      <img src="/assets/robotic-studio-1440.webp" width="1440" height="670" loading="eager" decoding="async" fetchpriority="high" alt="An imagined ivory ceramic robot arm holding a curling paper sample on a softly lit workbench"/>
    </picture>
    <span class="studio-orbit-note eyebrow" aria-hidden="true">↔ TURN THE VIEW</span>
  </div>
  <figcaption><span>An imagined robotics study.</span><button type="button" data-robot-fold hidden aria-label="Fold sample — replay the robotic paper study">Fold sample <span aria-hidden="true">↗</span></button></figcaption>
</figure>
<script is:inline>
  // Capture early intent before the optional renderer arrives; never delay content.
  (() => {
    const studio = document.querySelector('[data-robot-studio]');
    if (!studio) return;
    const interrupt = () => { studio.dataset.robotInterrupted = 'true'; };
    ['pointerdown', 'keydown', 'wheel', 'touchstart'].forEach(type => window.addEventListener(type, interrupt, { once:true, passive:true }));
    window.addEventListener('scroll', () => { if (scrollY > 24) interrupt(); }, { passive:true });
    if (performance.getEntriesByType('navigation')[0]?.type === 'back_forward') interrupt();
  })();
</script>
