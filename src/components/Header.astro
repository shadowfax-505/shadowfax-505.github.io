---
import { getCollection } from 'astro:content';
import Icon from './Icon.astro';
import { profile } from '../data/profile';
const path = Astro.url.pathname;
// The Notes link appears once a note is published.
const hasNotes = (await getCollection('notes', ({ data }) => !data.draft)).length > 0;
---
<a class="skip-link" href="#main">Skip to content</a>
<header class="site-header"><div class="header-inner container">
  <a class="wordmark" href="/" aria-label="m/r — Muttakin Rahman home">m/r<span aria-hidden="true">✳</span></a>
  <span class="header-edition eyebrow">FIELD JOURNAL<br/>VOL. 2026</span>
  <nav class="desktop-nav" aria-label="Main navigation"><a href="/#work" aria-current={path.startsWith('/work/')?'page':undefined}>Work <sup>01—06</sup></a><a href="/#services">Services</a><a href="/research/" aria-current={path.startsWith('/research/')?'page':undefined}>Research</a><a href="/#about">About</a>{hasNotes&&<a href="/notes/" aria-current={path.startsWith('/notes/')?'page':undefined}>Notes</a>}<a href="/cv/" aria-current={path.startsWith('/cv/')?'page':undefined}>CV</a><a href="/#contact">Contact <Icon size={13}/></a></nav>
  <div class="header-actions"><a class="header-cta" href={`mailto:${profile.email}?subject=Project%20enquiry`}>Start a project <Icon size={12}/></a><button class="motion-toggle" data-motion-toggle type="button" aria-pressed="false" hidden><span class="motion-dot" aria-hidden="true"></span>Reduce motion</button><details class="mobile-menu"><summary aria-label="Open navigation"><span></span><span></span></summary><nav aria-label="Mobile navigation"><a href="/#work">Selected work</a><a href="/#services">Services</a><a href="/research/">Research</a><a href="/#about">About</a>{hasNotes&&<a href="/notes/">Notes</a>}<a href="/cv/">CV</a><a href="/#contact">Contact</a><button class="motion-toggle menu-motion" data-motion-toggle type="button" aria-pressed="false" hidden><span class="motion-dot" aria-hidden="true"></span>Reduce motion</button></nav></details></div>
</div><div class="reading-progress" aria-hidden="true"></div></header>
