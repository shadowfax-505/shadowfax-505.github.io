---
import DroneStudy from './DroneStudy.astro';
interface Props { kind: 'civic'|'researchhub'|'zenflow'|'afo'|'gas'|'drone'; detail?: boolean }
const { kind, detail = false } = Astro.props;
const trace = Array.from({length:221},(_,i)=>`${i?'L':'M'}${30+i*3.36},${(205+Math.sin(i*.13)*8+Math.sin(i*.55)*Math.exp(-(((i%48)-24)**2)/60)*48).toFixed(1)}`).join(' ');
---
<figure class:list={['project-visual', `visual-${kind}`, { 'visual-detail': detail }]}>
  {!detail&&<div class="paper-project-window" data-paper-project aria-hidden="true"></div>}
  {kind==='civic'&&<><span class="visual-corner eyebrow">CIVICLENS / SYSTEM STUDY</span><div class="civic-word">public<br/><em>evidence.</em></div><svg class="civic-network" viewBox="0 0 800 500" fill="none" aria-hidden="true"><g stroke="currentColor" opacity=".3"><circle cx="555" cy="250" r="155"/><circle cx="555" cy="250" r="107"/><circle cx="555" cy="250" r="55"/><path d="M555 60v380M365 250h380M422 117l266 266M422 383l266-266"/></g><g stroke="#f16a50" stroke-width="2"><path data-living-path="civic" d="M422 172h78l55 78h90M555 250v107h109M555 250l72-108h69M555 250h-95l-40 68"/><circle cx="555" cy="250" r="10" fill="#f16a50"/><g class="living-evidence-packets"><circle class="living-evidence" data-living-marker="civic" r="4"/><circle class="living-evidence" style="offset-path:path('M555 250v107h109')" r="3"/><circle class="living-evidence" style="offset-path:path('M555 250l72-108h69')" r="3"/></g><circle cx="422" cy="172" r="4"/><circle cx="645" cy="250" r="4"/><circle cx="664" cy="357" r="4"/><circle cx="696" cy="142" r="4"/><circle cx="420" cy="318" r="4"/></g><g fill="currentColor" font-family="monospace" font-size="10"><text x="413" y="153">PROJECTS</text><text x="642" y="274">EVIDENCE</text><text x="648" y="125">CONTRACTS</text><text x="648" y="380">REVIEW</text></g></svg><div class="civic-records" aria-hidden="true"><span>01 — RECORDS</span><span>02 — RELATIONSHIPS</span><span>03 — CONTEXT ↗</span></div><figcaption>Original system illustration · records → evidence → review</figcaption></>}
  {kind==='researchhub'&&<><span class="visual-corner eyebrow">RESEARCHHUB / THE READING ROOM</span><div class="research-paper paper-back" aria-hidden="true"></div><div class="browser-frame"><div class="browser-bar" aria-hidden="true"><span>researchhub / discover</span><span>↗</span></div><img src="/assets/researchhub-feed.webp" srcset="/assets/researchhub-feed-640.webp 640w, /assets/researchhub-feed.webp 1280w" sizes={detail?'(max-width: 768px) 90vw, 1100px':'(max-width: 768px) 90vw, 700px'} width="1280" height="889" loading={detail?'eager':'lazy'} decoding="async" alt="Redesigned ResearchHub reading room with editorial paper cards, navigation and seeded development records"/></div><span class="artifact-annotation" aria-hidden="true">follow an idea<br/><em>further ↗</em></span><figcaption>Updated app · local Oracle · seeded development records</figcaption></>}
  {kind==='zenflow'&&<><span class="visual-corner eyebrow">ZENFLOW / A LITTLE LESS NOISE</span><div class="focus-face"><span class="living-focus-orbit" aria-hidden="true"></span><span class="eyebrow">ONE THING AT A TIME</span><strong>25<span>:</span>00</strong><div class="focus-track"><span></span></div><span class="focus-word eyebrow">FOCUS → RECORD → REFLECT</span></div><div class="zen-side-note eyebrow">DESKTOP<br/>+ ANDROID<br/>+ LOCAL AI</div><figcaption>Original focus-workflow illustration</figcaption></>}
  {kind==='afo'&&<><span class="visual-corner eyebrow">AFO / ACQUISITION STUDY</span><div class="afo-word">listen to<br/><em>the signal.</em></div><svg class="afo-signal" viewBox="0 0 800 400" fill="none" aria-hidden="true"><g stroke="currentColor" opacity=".15">{[85,145,205,265,325].map(y=><path d={`M30 ${y}h740`}/>)}{[30,130,230,330,430,530,630,730].map(x=><path d={`M${x} 65v270`}/>)}</g><path d={trace} stroke="currentColor" stroke-width="1.7"/><rect class="living-sweep-glow" x="22" y="65" width="16" height="270"/><path class="living-sweep" d="M30 65v270"/><path d="M30 288c40 0 40-22 80-22s40 50 80 50 40-34 80-34 40-12 80-12 40 42 80 42 40-38 80-38 40-7 80-7 40 20 80 20" stroke="currentColor" opacity=".45" stroke-width="1.3"/></svg><div class="afo-flow eyebrow"><span>SENSE</span><span>SYNC</span><span>RECORD</span><span>RECOVER ↗</span></div><figcaption>Signal-flow illustration · physical validation pending</figcaption></>}
  {kind==='gas'&&<><span class="visual-corner eyebrow">EARLY BUILD / CLOSED LOOP</span><svg class="gas-system" viewBox="0 0 600 330" fill="none" aria-hidden="true"><g stroke="currentColor"><path d="M137 165h87m152 0h64m0 0V84h48m-48 81h48m-48 0v81h48"/><path d="m213 160 5 5-5 5m266-91 5 5-5 5m0 71 5 5-5 5m0 71 5 5-5 5"/></g><circle cx="99" cy="165" r="37" stroke="currentColor"/><circle cx="99" cy="165" r="17" stroke="currentColor"/><path d="M90 171c-7-12 9-12 2-24m10 24c-7-12 9-12 2-24" stroke="currentColor"/><rect x="224" y="111" width="152" height="108" fill="currentColor"/><g fill="#f7f3e9" font-family="monospace" text-anchor="middle"><text x="300" y="159" font-size="24">ESP32</text><text x="300" y="183" font-size="10">AUTOMATIC RESPONSE</text></g><g stroke="currentColor"><rect x="488" y="60" width="85" height="48"/><rect x="488" y="141" width="85" height="48"/><rect x="488" y="222" width="85" height="48"/></g><g fill="currentColor" font-family="monospace" text-anchor="middle" font-size="11"><text x="99" y="226">DETECT GAS</text><text x="530" y="89">ALARM</text><text x="530" y="170">FAN</text><text x="530" y="251">WEB ALERT</text></g><circle class="signal-dot" cx="181" cy="165" r="4" fill="currentColor"/><circle class="living-gas-packet" style="offset-path:path('M99 165h341V84h48')" r="4"/><circle class="living-gas-packet packet-1" style="offset-path:path('M99 165h389')" r="4"/><circle class="living-gas-packet packet-2" style="offset-path:path('M99 165h341v81h48')" r="4"/><circle class="living-alarm" cx="530" cy="84" r="35" stroke="var(--accent)"/><g class="living-fan" stroke="var(--accent)"><path d="M519 165h22m-11-11v22"/></g><circle class="living-web" cx="564" cy="230" r="3" fill="var(--accent)"/></svg><figcaption>Remembered system flow · original diagram</figcaption></>}
  {kind==='drone'&&<><DroneStudy/><span class="visual-corner eyebrow">EARLY BUILD / FLIGHT STUDY</span><figcaption>3D reconstruction of an F450-class quad; original photos lost.</figcaption></>}
</figure>
