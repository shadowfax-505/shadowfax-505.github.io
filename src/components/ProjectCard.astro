---
import type { CollectionEntry } from 'astro:content';
import Notebook from './Notebook.astro';
import { projectNotebooks } from '../data/notebooks';
import { statuses } from '../data/status';
import Icon from './Icon.astro';
interface Props { project: CollectionEntry<'work'> }
const { project } = Astro.props;
const { data } = project;
const early = data.kind === 'early';
---
<article class:list={['work-card',`work-${data.visual}`,{'early-card':early}]} data-reveal><Notebook book={projectNotebooks[data.visual]} cover={data.visual}/><div class="work-card-body"><div class="work-meta eyebrow"><span>0{data.order} / {data.category}</span><Icon size={22}/></div><h3><a class="project-title-link" href={`/work/${project.id}/`}>{data.title}</a></h3><p>{data.summary}</p><div class="work-card-footer"><span>{data.stack.slice(0, 3).join(' / ')}</span>{data.statuses.map(s => <span class="project-status">{statuses[s]}</span>)}</div><a class="project-open" data-case-link href={`/work/${project.id}/`}>Read case study <Icon size={16}/></a></div></article>
