---
import { profile } from '../data/profile';
const year = new Date().getFullYear();
---
<footer class="site-footer">
  <div class="footer-inner container">
    <span>© {year} {profile.fullName} · {profile.location}</span>
    <nav aria-label="Footer">
      <a href={`mailto:${profile.email}`}>Email</a>
      <a href={profile.github} rel="me noopener" target="_blank">GitHub</a>
      <a href={profile.linkedin} rel="me noopener" target="_blank">LinkedIn</a>
      <a href="/cv/">CV</a>
      <a href="https://github.com/shadowfax-505/shadowfax-505.github.io" rel="noopener" target="_blank">Site source</a>
    </nav>
  </div>
</footer>
