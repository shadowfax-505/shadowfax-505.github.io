---
// Static fallback: an F450-class quad seen from above, drawn to the same proportions as the 3D model.
const arms = [45, 135, 225, 315];
const R = 150; // motor radius in px for a 450 mm diagonal
---
<div class="drone" data-drone data-visible="false" data-webgl="pending">
  <svg class="drone-fallback" viewBox="0 0 640 400" fill="none" role="img" aria-label="Top-down drawing of an F450-class quadcopter with red front arms, four propellers and a GPS puck">
    <g transform="translate(320 200) scale(1 .62)">
      {arms.map((a, i) => {
        const r = (a * Math.PI) / 180, x = Math.sin(r) * R, y = -Math.cos(r) * R, front = i === 0 || i === 3;
        return <g>
          <path d={`M${Math.sin(r) * 30} ${-Math.cos(r) * 30}L${x} ${y}`} stroke={front ? '#c7372b' : '#cfcac0'} stroke-width="16" stroke-linecap="round"/>
          <circle cx={x} cy={y} r="85" stroke="currentColor" stroke-opacity=".12"/>
          <circle cx={x} cy={y} r="14" fill="#9fa3a8" stroke="currentColor" stroke-opacity=".5"/>
          <path d={`M${x - 82} ${y + 8}C${x - 40} ${y - 10} ${x + 40} ${y + 10} ${x + 82} ${y - 8}`} stroke={front ? '#d04a2a' : 'currentColor'} stroke-opacity=".7" stroke-width="5" stroke-linecap="round"/>
        </g>;
      })}
      <rect x="-52" y="-52" width="104" height="104" rx="18" transform="rotate(45)" fill="#23272c"/>
      <rect x="-24" y="-20" width="48" height="40" rx="4" fill="#141619" stroke="#3a3f45"/>
      <circle cx="0" cy="48" r="26" fill="#1a1c20" stroke="#3a3f45"/>
    </g>
  </svg>
  <canvas aria-hidden="true"></canvas>
  <div class="drone-surface" data-drone-orbit tabindex="0" role="group" aria-label="3D drone view. Drag or use the arrow keys to orbit; Home resets the view." hidden></div>
  <div class="drone-toolbar" data-drone-controls hidden>
    <div class="seg" role="group" aria-label="Flight mode">
      <button type="button" data-drone-flight="hover" aria-pressed="true">Hover</button>
      <button type="button" data-drone-flight="orbit" aria-pressed="false">Orbit</button>
    </div>
    <div class="seg" role="group" aria-label="Camera">
      <button type="button" data-drone-view="left" aria-label="Turn view left">←</button>
      <button type="button" data-drone-view="right" aria-label="Turn view right">→</button>
      <button type="button" data-drone-view="reset">Reset</button>
    </div>
  </div>
</div>
