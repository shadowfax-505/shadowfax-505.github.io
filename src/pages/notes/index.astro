---
import { getCollection } from 'astro:content';
import Layout from '../../layouts/Layout.astro';
import { profile } from '../../data/profile';
const notes = (await getCollection('notes', ({ data }) => !data.draft)).sort((a, b) => +b.data.date - +a.data.date);
---
<Layout title={`Notes — ${profile.name}`} description="Short engineering notes by Muttakin Rahman: what I built, what broke and what I measured along the way." noindex={notes.length === 0}>
<main id="main" tabindex="-1">
  <header class="page-intro container"><a class="back-link eyebrow" href="/">← BACK TO HOME</a><div class="page-intro-top"><span class="eyebrow">NOTES / FROM THE BENCH</span><span class="eyebrow accent">SHORT WRITE-UPS</span></div><h1 data-reveal>Notes,<br/><em>as I go.</em></h1><p class="page-intro-description">Short write-ups on things I learned while building: what broke, what I measured, what I would do differently.</p></header>
  <div class="container" style="padding-bottom:80px">
    {notes.length === 0 ? <p class="muted">Nothing published yet.</p> :
    <ol class="research-full">{notes.map(n => <li><p class="eyebrow">{n.data.date.toLocaleDateString('en-GB', { day: 'numeric', month: 'short', year: 'numeric' })}</p><div><h2><a href={`/notes/${n.id}/`}>{n.data.title}</a></h2><p class="muted">{n.data.summary}</p></div></li>)}</ol>}
  </div>
</main>
</Layout>
