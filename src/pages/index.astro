---
import { getCollection } from 'astro:content';
import Layout from '../layouts/Layout.astro';
import Hero from '../components/Hero.astro';
import Icon from '../components/Icon.astro';
import Chips from '../components/Chips.astro';
import DroneStudy from '../components/DroneStudy.astro';
import { profile, services, achievements, community, elsewhere, press } from '../data/profile';

const work = (await getCollection('work')).sort((a, b) => a.data.order - b.data.order);
const selected = work.filter(w => w.data.kind === 'selected');
const [feature, ...rest] = selected;
const drone = work.find(w => w.id === 'drone')!;
const gas = work.find(w => w.id === 'gas-safety')!;
const research = (await getCollection('research')).sort((a, b) => a.data.order - b.data.order);
const article = press[0];
const fmtDate = (iso: string) => new Date(iso).toLocaleDateString('en-GB', { day: 'numeric', month: 'long', year: 'numeric' });
---
<Layout>
<main id="main" tabindex="-1">
  <Hero/>

  <section class="section" id="work" aria-labelledby="work-title">
    <div class="container">
      <div class="section-head">
        <p class="label">01 · Selected work</p>
        <div><h2 id="work-title">Things I have built, and how I checked them.</h2>
        <p>Every project says what was shipped, what was tested and what is still waiting on hardware. The tags use those words on purpose.</p></div>
      </div>

      <article class="feature reveal">
        <a class="feature-media" href={`/work/${feature.id}/`} tabindex="-1" aria-hidden="true">
          {feature.data.cover && <img src="/assets/afo/board-render-900.webp" srcset="/assets/afo/board-render-600.webp 600w, /assets/afo/board-render-900.webp 940w, /assets/afo/board-render.webp 1582w" sizes="(min-width: 960px) 460px, 80vw" width="940" height="570" alt="" loading="lazy"/>}
        </a>
        <div>
          <p class="label label-accent">Embedded systems · {feature.data.year}</p>
          <h3><a href={`/work/${feature.id}/`}>{feature.data.title}</a></h3>
          <p>{feature.data.summary}</p>
          <div class="metrics">{feature.data.metrics.map(m => <div class="metric"><strong>{m.value}</strong><span>{m.label}</span></div>)}</div>
          <div class="button-row" style="align-items:center;justify-content:space-between">
            <Chips items={feature.data.statuses}/>
            <a class="text-link" href={`/work/${feature.id}/`}>Read the case study <Icon name="right" size={15}/></a>
          </div>
        </div>
      </article>

      <div class="work-grid">
        {rest.map(w => <article class="card reveal">
          <div class="card-media">
            {w.data.cover
              ? <img src={w.data.cover.src} srcset={`${w.data.cover.src.replace('.webp', '-640.webp')} 640w, ${w.data.cover.src} ${w.data.cover.width}w`} sizes="(min-width: 760px) 360px, 92vw" width={w.data.cover.width} height={w.data.cover.height} alt="" loading="lazy"/>
              : <dl class="card-media-text">{w.data.metrics.map(m => <div><dt>{m.value}</dt><dd>{m.label}</dd></div>)}</dl>}
          </div>
          <div class="card-body">
            <Chips items={w.data.statuses}/>
            <h3><a href={`/work/${w.id}/`}>{w.data.title}</a></h3>
            <p>{w.data.summary}</p>
            <p class="stack">{w.data.stack.join(' · ')}</p>
          </div>
        </article>)}
      </div>
    </div>
  </section>

  <section class="section" id="services" aria-labelledby="services-title">
    <div class="container">
      <div class="section-head">
        <p class="label">02 · Work with me</p>
        <div><h2 id="services-title">What I can build for you.</h2>
        <p>{profile.availability}. Each area below links to a project where I have already done it.</p></div>
      </div>
      <div class="services reveal">
        {services.map((s, i) => <div class="service">
          <span class="service-index">0{i + 1}</span>
          <h3>{s.title}</h3>
          <p>{s.text}</p>
          <ul>{s.items.map(item => <li>{item}</li>)}</ul>
          <a class="text-link" href={s.proof.href}>See it in {s.proof.label} <Icon name="right" size={14}/></a>
        </div>)}
      </div>
      <div class="button-row" style="margin-top:28px">
        <a class="button" href={`mailto:${profile.email}?subject=Project%20enquiry`}><Icon name="mail" size={16}/> Start a conversation</a>
        <a class="button button-ghost" href="/cv/"><Icon name="doc" size={16}/> Read my CV</a>
      </div>
    </div>
  </section>

  <section class="section" id="research" aria-labelledby="research-title">
    <div class="container">
      <div class="section-head">
        <p class="label">03 · Research</p>
        <div><h2 id="research-title">Questions I am working on.</h2>
        <p>Four studies, all unpublished. Results stay off this page until they have been reviewed; the questions and methods are here.</p></div>
      </div>
      <ol class="research-list">
        {research.map(r => <li class="research-item reveal">
          <p class="label">{r.data.area}</p>
          <div><h3>{r.data.title}</h3><p>{r.data.question}</p></div>
          <Chips items={[r.data.status]}/>
        </li>)}
      </ol>
      <p style="margin-top:24px"><a class="text-link" href="/research/">Methods and status for each study <Icon name="right" size={14}/></a></p>
    </div>
  </section>

  <section class="section" id="early" aria-labelledby="early-title">
    <div class="container">
      <div class="section-head">
        <p class="label">04 · Before university</p>
        <div><h2 id="early-title">Where it started.</h2>
        <p>Two school projects that got me into building things that move and sense.</p></div>
      </div>
      <div class="early">
        <figure class="drone-panel" style="margin:0">
          <DroneStudy/>
          <figcaption class="drone-caption"><span>3D reconstruction of an F450-class quad. Original photos lost.</span><span class="mono">Drag to orbit</span></figcaption>
        </figure>
        <div class="early-side">
          <Chips items={drone.data.statuses}/>
          <h3><a href={`/work/${drone.id}/`} style="text-decoration:none">{drone.data.title}, {drone.data.year}</a></h3>
          <p class="muted" style="margin:0">{drone.data.summary} I was one of the five.</p>
          <a class="press-card" href={article.url} target="_blank" rel="noopener" style="text-decoration:none">
            <span class="label">{article.outlet} · {fmtDate(article.date)}</span>
            <span class="bn" lang="bn">{article.title}</span>
            <span class="muted" style="font-size:15px">“{article.translation}” <Icon name="arrow" size={14} class="inline"/></span>
          </a>
          <div class="early-mini">
            <h4><a href={`/work/${gas.id}/`} style="text-decoration:none">{gas.data.title}</a></h4>
            <p class="muted" style="margin:0;font-size:15.5px">{gas.data.summary}</p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <section class="section" id="about" aria-labelledby="about-title">
    <div class="container">
      <div class="section-head">
        <p class="label">05 · About</p>
        <div><h2 id="about-title">Recognition and community.</h2>
        <p>I study Computer Science & Engineering at KUET. Before that, physics olympiads taught me to stay with a hard problem; now I spend that patience on datasheets and test cases.</p></div>
      </div>
      <div class="two-col">
        <div>
          <p class="label sub-head">Recognition</p>
          <ul class="rows">{achievements.map(a => <li><strong>{a.url ? <a href={a.url} target="_blank" rel="noopener">{a.title}</a> : a.title}</strong><span class="when">{a.date}</span><span class="detail">{a.detail}</span></li>)}</ul>
        </div>
        <div>
          <p class="label sub-head">Community</p>
          <ul class="rows">{community.map(c => <li><strong>{c.title}</strong><span class="when">{c.since}</span><span class="detail">{c.role}</span></li>)}</ul>
          <p class="label sub-head" style="margin-top:36px">Also built</p>
          <ul class="rows">{elsewhere.map(e => <li><strong>{e.url ? <a href={e.url} target="_blank" rel="noopener">{e.title}</a> : e.title}</strong><span class="detail">{e.text}</span></li>)}</ul>
        </div>
      </div>
    </div>
  </section>

  <section class="contact" id="contact" aria-labelledby="contact-title">
    <div class="container contact-grid">
      <div>
        <p class="availability"><span class="dot" aria-hidden="true"></span>{profile.availability}</p>
        <h2 id="contact-title">Tell me what you are building.</h2>
        <p>A board that needs firmware, an app that needs a backend, a study that needs a careful pipeline. Email is the quickest way to reach me.</p>
        <a class="email-big" href={`mailto:${profile.email}`}>{profile.email}</a>
        <div class="button-row" style="margin-top:20px"><button class="button button-ghost" type="button" data-copy={profile.email} hidden><Icon name="copy" size={16}/> Copy address</button></div>
      </div>
      <ul class="contact-links">
        <li><a href={profile.github} target="_blank" rel="me noopener"><span><Icon name="github" size={18} class="inline"/> GitHub</span><Icon name="arrow"/></a></li>
        <li><a href={profile.linkedin} target="_blank" rel="me noopener"><span><Icon name="linkedin" size={18} class="inline"/> LinkedIn</span><Icon name="arrow"/></a></li>
        <li><a href="/cv/"><span><Icon name="doc" size={18} class="inline"/> CV (printable)</span><Icon name="arrow"/></a></li>
      </ul>
    </div>
  </section>
</main>
</Layout>
<style>
  .feature-media img { width: 100%; }
  .contact-links span { display: inline-flex; align-items: center; gap: 10px; }
  :global(svg.inline) { display: inline-block; vertical-align: -2px; }
</style>
