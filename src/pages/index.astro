---
import { getCollection } from 'astro:content';
import Layout from '../layouts/Layout.astro';
import Hero from '../components/Hero.astro';
import ProjectCard from '../components/ProjectCard.astro';
import Contact from '../components/Contact.astro';
import ResearchAtlas from '../components/ResearchAtlas.astro';
import Icon from '../components/Icon.astro';
import Notebook from '../components/Notebook.astro';
import FutureMilestones from '../components/FutureMilestones.astro';
import { backgroundNotebook } from '../data/notebooks';
import { statuses } from '../data/status';
import { profile, services, achievements, community, elsewhere } from '../data/profile';
const projects = (await getCollection('work')).sort((a, b) => a.data.order - b.data.order);
const research = (await getCollection('research')).sort((a, b) => a.data.order - b.data.order);
// Four numbers a visitor can check, each linked to the page that sources it.
const proof = [
  { value: '6', label: 'board variants designed in KiCad, DRC and ERC clean', status: 'tested', href: '/work/afo-recorder/', source: 'AFO recorder' },
  { value: '18 / 18', label: 'fault scenarios passed by the production firmware in Wokwi', status: 'simulated', href: '/work/afo-recorder/', source: 'AFO recorder' },
  { value: '69 / 70', label: 'local-AI answers usable on the first try, measured over seven tasks', status: 'tested', href: '/work/zenflow/', source: 'ZenFlow' },
  { value: '65', label: 'integration checks passing against a live Oracle database', status: 'tested', href: '/work/researchhub/', source: 'ResearchHub' },
] as const;
// How the work gets checked, each step with a project that shows it.
const method = [
  { title: 'Read the source first', text: 'Every AD7606 timing figure and ICM-42688-P register the firmware touches, checked against the datasheets. That caught a timestamp-unit bug and a supply-ramp hazard before any board was made.', href: '/work/afo-recorder/', label: 'AFO recorder' },
  { title: 'Simulate before building', text: 'Custom Wokwi chips run the production firmware through 18 fault scenarios, and ngspice sweeps the analog filter across 16 tolerance corners.', href: '/work/afo-recorder/', label: 'AFO recorder' },
  { title: 'Test the whole workflow', text: 'Browser journeys that save, reload, upload and download, and integration checks against a live database, not only unit tests.', href: '/work/researchhub/', label: 'ResearchHub' },
  { title: 'Measure what the AI does', text: 'Every model answer is checked against the user’s data, retried once, and falls back to rules in plain view. Its reliability is measured, not assumed.', href: '/work/zenflow/', label: 'ZenFlow' },
  { title: 'Leave a record', text: 'Release notes, assembly guides, an evaluation report and, for CivicLens, 38 design documents kept next to the code.', href: '/work/civiclens/', label: 'CivicLens' },
];
---
<Layout><main id="main" tabindex="-1"><Hero/>
  <section class="proof-section container" id="proof" aria-labelledby="proof-title"><div class="proof-head"><p class="section-label eyebrow">THE SHORT VERSION</p><h2 id="proof-title" class="proof-title" data-reveal>Proof,<em> not adjectives.</em></h2></div><div class="proof-grid">{proof.map(p => <a class="proof-item" href={p.href}><strong>{p.value}</strong><span>{p.label}</span><span class="proof-foot"><span class="status-pill">{statuses[p.status]}</span><span class="eyebrow">{p.source} ↗</span></span></a>)}</div></section>
  <section class="section container work-section" id="work" aria-labelledby="work-title"><div class="section-heading"><div><p class="section-label eyebrow">01 / THINGS I’VE BUILT</p><h2 id="work-title" data-reveal>Selected <em>work.</em></h2></div><p class="section-description">From physical signals to public records.<br/>Four systems, with the checking left in.</p></div><div class="work-grid">{projects.filter(p => p.data.kind === 'selected').map(project => <ProjectCard project={project}/>)}</div><a class="text-link all-code" href={profile.github} target="_blank" rel="noopener noreferrer">The rest of the work lives on GitHub <Icon size={17}/></a></section>

  <section class="services-section section" id="services" aria-labelledby="services-title"><div class="container"><div class="section-heading"><div><p class="section-label eyebrow">02 / WORK WITH ME</p><h2 id="services-title" data-reveal>What I can<br/><em>build for you.</em></h2></div><p class="section-description">{profile.availability}.<br/>Each area links to a project where I have already done it.</p></div><div class="service-grid">{services.map((s, i) => <article class="service-card"><span class="service-number">0{i + 1}</span><h3>{s.title}</h3><p>{s.text}</p><ul>{s.items.map(item => <li>{item}</li>)}</ul><a class="text-link" href={s.proof.href}>See it in {s.proof.label} <Icon size={16}/></a></article>)}</div><div class="method"><div class="method-head"><p class="section-label eyebrow">HOW I WORK</p><h3>Checked before<br/><em>it is called done.</em></h3></div><ol class="method-steps">{method.map((m, i) => <li><span class="method-number">0{i + 1}</span><div><h4>{m.title}</h4><p>{m.text}</p></div><a class="text-link" href={m.href}>{m.label} <Icon size={14}/></a></li>)}</ol></div><div class="service-actions"><a class="button button-lime" href={`mailto:${profile.email}?subject=Project%20enquiry`}>Start a conversation <Icon size={16}/></a><a class="button" href="/cv/">Read my CV <Icon name="doc" size={16}/></a></div></div></section>

  <section class="research-section section" aria-labelledby="research-title"><div class="container"><div class="section-heading"><div><p class="section-label eyebrow">03 / OPEN QUESTIONS</p><h2 id="research-title" data-reveal>A few things<br/><em>on my mind.</em></h2></div><div class="research-intro"><p>Dialects that AI transcription quietly erases. Names that look the same but run differently. Compilers that steer language models. Shops that cannot see the demand they missed.</p><a class="text-link" href="/research/">Questions, methods and status <Icon size={18}/></a></div></div><div class="research-spread"><ResearchAtlas/><div class="research-list">{research.map((item, i) => <a data-research-select={i} class="research-row" href={`/research/#${item.id}`} data-reveal><span class="research-number">0{i + 1}</span><div><div class="eyebrow research-keyword">{item.data.area}</div><h3>{item.data.title}</h3><p>{item.data.question}</p></div><div class="research-row-end"><span class="status-pill">{statuses[item.data.status]}</span><Icon size={28}/></div></a>)}</div></div><div class="research-next"><p><span class="small-star" aria-hidden="true">✳</span> Unpublished work: the questions and their status, no results until the papers are out.</p><div class="research-next-links"><a href="/research/#compiler-study" class="text-link">Try the compiler specimen <Icon size={18}/></a><a href="/research/" class="text-link">Read the research notes <Icon size={18}/></a></div></div></div></section>

  <section class="section container early-section" id="early-builds" aria-labelledby="early-title"><div class="section-heading"><div><p class="section-label eyebrow">04 / FROM THE EARLY WORKBENCH</p><h2 id="early-title" data-reveal>Before the code,<br/><em>there were wires.</em></h2></div><p class="section-description">Two school builds.<br/>The beginnings of a hands-on education.</p></div><div class="early-grid">{projects.filter(p => p.data.kind === 'early').map(project => <ProjectCard project={project}/>)}</div></section>

  <section class="section container recognition-section" aria-labelledby="recognition-title"><div class="recognition-intro"><p class="section-label eyebrow">05 / A FEW MILESTONES</p><h2 id="recognition-title" data-reveal>Physics was<br/><em>the first spark.</em></h2><p>Competitions that rewarded asking why,<br/>and staying with a difficult problem.</p><span class="recognition-star" aria-hidden="true">✳</span></div><div class="achievements">{achievements.map(a => <article class="achievement" data-reveal><span class="achievement-marker" aria-hidden="true">{a.marker}</span><div><h3>{a.title}</h3><p>{a.detail}</p>{a.url && <a href={a.url} class="achievement-source" target="_blank" rel="noopener noreferrer">{a.source} <Icon size={12}/></a>}</div><span class="achievement-date eyebrow">{a.date}</span></article>)}</div></section>

  <FutureMilestones/>

  <section class="about-section section" id="about" aria-labelledby="about-title"><div class="container"><p class="section-label eyebrow">07 / A LITTLE ABOUT ME</p><div class="about-grid"><div><h2 id="about-title" data-reveal>Still asking<br/><em>“what if?”</em></h2><div class="about-signature">Muttakin Rahman <span aria-hidden="true">↗</span></div></div><div class="about-copy"><p class="about-lead">I’m Muttakin, a Computer Science & Engineering student at KUET, Bangladesh.</p><p>I like the point where an idea has to become a real system: when the database needs a model, the sensor needs a clock, and an experiment needs a fair test.</p><p>That curiosity has taken me from a school drone team to a wearable EMG recorder, civic software and research tools. Today I am working on dialects in AI transcription, look-alike identifiers in programming languages, compilers that guide language models, and inventory under stockouts.</p><a class="text-link" href={profile.linkedin} target="_blank" rel="noopener noreferrer">Find me on LinkedIn <Icon size={16}/></a></div></div><div class="community-strip"><div class="education"><span class="eyebrow">EDUCATION</span><h3>Computer Science & Engineering</h3><p>{profile.university}</p></div><div class="community"><span class="eyebrow">LEARNING WITH OTHERS</span>{community.map(c => <div class="community-item"><h3 title={c.title}>{c.short}</h3><span>{c.role}</span><small>{c.since}</small></div>)}</div></div><div class="elsewhere-strip"><span class="eyebrow">ALSO BUILT</span>{elsewhere.map(e => <div class="elsewhere-item"><h3>{e.url ? <a href={e.url} target="_blank" rel="noopener noreferrer">{e.title} <Icon size={13}/></a> : e.title}</h3><p>{e.text}</p></div>)}</div><div class="background-notebook"><Notebook book={backgroundNotebook}/></div></div></section><Contact/>
</main></Layout>
